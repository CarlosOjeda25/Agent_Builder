# Agent Builder — Configuration Template
# Renombra este archivo a .env y completa con tus claves

# Perfil activo: local, openrouter, groq, nvidia, openai, claude
MODEL_PROFILE=openrouter
MODEL=meta-llama/llama-3.1-8b-instruct

# Local Ollama (dentro de la red Docker)
OLLAMA_HOST=http://agent_builder_ollama:11434
API_BASE=http://agent_builder_ollama:11434

# Proveedores Cloud (completar según el perfil que uses)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
GROQ_API_KEY=tu_groq_api_key_aqui
NVIDIA_API_KEY=tu_nvidia_api_key_aqui

# Litellm / CrewAI settings
LITELLM_DROP_PARAMS=true
CREWAI_REQUEST_TIMEOUT=600
